#!/bin/bash
# 腾讯云函数 SCF（Web 函数）启动脚本
# SCF Web 函数会把 HTTP 请求转发到本脚本启动的 Web 服务，并注入 PORT 环境变量（默认 9000）。
# 用法：在 SCF 控制台创建「Web 函数」→ 运行环境 Python3.11 → 上传本仓库 → 启动命令填 scf_bootstrap
cd /var/user 2>/dev/null || cd "$(dirname "$0")"
pip install -r requirements.txt -q 2>/dev/null
export PORT=${PORT:-9000}
python server.py
